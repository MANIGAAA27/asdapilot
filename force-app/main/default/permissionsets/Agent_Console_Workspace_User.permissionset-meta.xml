<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Console Workspace User</label>
    <description>Grants access to the Agent Console Workspace: Case read/edit, Case_Recommendation__c read, custom fields, and AgentConsoleWorkspaceService Apex class.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>AgentConsoleWorkspaceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Case_Recommendation__c read only -->
    <objectPermissions>
        <object>Case_Recommendation__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Case read + edit (workspace tracking field update) -->
    <objectPermissions>
        <object>Case</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Case custom field permissions -->
    <fieldPermissions>
        <field>Case.Workspace_Used__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Workspace_Opened_At__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Resolution_Time_Minutes__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- Case_Recommendation__c field permissions -->
    <fieldPermissions>
        <field>Case_Recommendation__c.Case__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Recommendation_Text__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Recommendation_Type__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Confidence_Score__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
</PermissionSet>
