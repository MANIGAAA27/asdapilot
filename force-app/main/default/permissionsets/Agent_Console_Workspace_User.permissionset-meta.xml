<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Console Workspace User</label>
    <description>Grants Service Managers and Support Agents the access required to use the Agent Console Workspace LWC. Provides read access to Case custom fields, Case_Recommendation__c, and SLA_Config__mdt, plus Apex class access.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>

    <!-- ── Apex class access ──────────────────────────────────────────── -->
    <classAccesses>
        <apexClass>AgentConsoleWorkspaceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- ── Field permissions — ALL grouped together, sorted A→Z by field ── -->
    <fieldPermissions>
        <field>Case.Resolution_Time_Minutes__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Workspace_Opened_At__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Workspace_Used__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Case__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Confidence_Score__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Is_Applied__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Recommendation_Text__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Resolution_Type__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- ── Object permissions — ALL grouped together ─────────────────── -->
    <objectPermissions>
        <object>Case_Recommendation__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
</PermissionSet>
