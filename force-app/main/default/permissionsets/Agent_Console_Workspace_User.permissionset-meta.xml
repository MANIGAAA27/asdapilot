<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Console Workspace User</label>
    <description>Grants read access to all data surfaces used by the agentConsoleWorkspace LWC: Case and related objects, Case_Recommendation__c, and the AgentConsoleWorkspaceService Apex class. Assign to Support Agent and Service Manager users.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>

    <!-- ─── Apex Class Access ─────────────────────────────────────── -->
    <classAccesses>
        <apexClass>AgentConsoleWorkspaceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- ─── Object Permissions ───────────────────────────────────── -->
    <objectPermissions>
        <object>Case_Recommendation__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- ─── Field Permissions — Case custom fields ───────────────── -->
    <fieldPermissions>
        <field>Case.Workspace_Used__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Workspace_Opened_At__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Resolution_Time_Minutes__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- ─── Field Permissions — Case_Recommendation__c ──────────── -->
    <fieldPermissions>
        <field>Case_Recommendation__c.Case__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Recommendation_Text__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Resolution_Summary__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Confidence_Score__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Source__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case_Recommendation__c.Recommendation_Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
