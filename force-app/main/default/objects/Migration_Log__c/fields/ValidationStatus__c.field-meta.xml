<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ValidationStatus__c</fullName>
    <label>Validation Status</label>
    <description>Tracks the validation outcome for this migration log entry. Used by the ARMT_ValidationService to classify issues as Blocker, Warning, or Info.</description>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>true</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Passed</fullName>
                <default>false</default>
                <label>Passed</label>
            </value>
            <value>
                <fullName>Info</fullName>
                <default>false</default>
                <label>Info</label>
            </value>
            <value>
                <fullName>Warning</fullName>
                <default>false</default>
                <label>Warning</label>
            </value>
            <value>
                <fullName>Blocker</fullName>
                <default>false</default>
                <label>Blocker</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
