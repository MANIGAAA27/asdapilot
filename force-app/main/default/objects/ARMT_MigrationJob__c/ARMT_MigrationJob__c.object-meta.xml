<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>ARMT Migration Job</label>
    <pluralLabel>ARMT Migration Jobs</pluralLabel>
    <description>Tracks migration jobs for the Advanced Record Migration Tool (ARMT), including status, start/end times, and migration metadata.</description>
    <nameField>
        <label>Job Name</label>
        <type>AutoNumber</type>
        <displayFormat>Job-{00000}</displayFormat>
