<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GenerationStatus__c</fullName>
    <label>Generation Status</label>
    <description>Tracks the lifecycle state of the summary generation job. Values: In Progress (queued/running), Success (completed), Failed (error occurred). Used by UI to display loading/error states.</description>
    <type>Picklist</type>
    <required>false</required>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>In Progress</fullName>
                <default>false</default>
                <label>In Progress</label>
            </value>
            <value>
                <fullName>Success</fullName>
                <default>false</default>
                <label>Success</label>
            </value>
            <value>
                <fullName>Failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
