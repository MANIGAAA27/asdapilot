<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Delete Old Case Transfer Summaries</label>
    <description>Deletes CaseTransferSummary__c records for Cases that have been closed for 12 months. Runs asynchronously on a scheduled path triggered by Case ClosedDate. Implements HLD-CMP-012 and TR-10.</description>
    <interviewLabel>Delete Old Case Transfer Summaries {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <runInMode>SystemModeWithSharing</runInMode>
    <triggerType>RecordAfterSave</triggerType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <scheduledPaths>
            <name>DeleteAfter12Months</name>
            <label>Delete After 12 Months</label>
            <offsetNumber>12</offsetNumber>
            <offsetUnit>Months</offsetUnit>
            <recordField>ClosedDate</recordField>
            <timeSource>RecordField</timeSource>
            <connector>
                <targetReference>GetSummariesToDelete</targetReference>
            </connector>
        </scheduledPaths>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
    </start>
    <recordLookups>
        <name>GetSummariesToDelete</name>
        <label>Get Summaries To Delete</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>CheckHasSummaries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CaseTransferSummary__c</object>
        <outputReference>summariesToDelete</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Case__c</queriedFields>
    </recordLookups>
    <decisions>
        <name>CheckHasSummaries</name>
        <label>Check Has Summaries</label>
        <locationX>312</locationX>
        <locationY>250</locationY>
        <defaultConnector>
            <targetReference>NoSummariesToDelete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Summaries</defaultConnectorLabel>
        <rules>
            <name>HasSummaries</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>summariesToDelete</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DeleteSummaries</targetReference>
            </connector>
            <label>Has Summaries</label>
        </rules>
    </decisions>
    <recordDeletes>
        <name>DeleteSummaries</name>
        <label>Delete Summaries</label>
        <locationX>440</locationX>
        <locationY>380</locationY>
        <inputReference>summariesToDelete</inputReference>
    </recordDeletes>
    <recordDeletes>
        <name>NoSummariesToDelete</name>
        <label>No Summaries To Delete</label>
        <locationX>312</locationX>
        <locationY>380</locationY>
        <inputReference>summariesToDelete</inputReference>
    </recordDeletes>
    <variables>
        <name>summariesToDelete</name>
        <dataType>SObject</dataType>
        <objectType>CaseTransferSummary__c</objectType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
