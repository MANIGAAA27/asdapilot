<?xml version="1.0" encoding="UTF-8"?>
<!-- MODIFIED 2026-06-08 — Project: Gift Basket | CodeImplementation-GiftBasket | ASDA -->
<!-- Project: Gift Basket | LLD-GiftBasket -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Guided screen flow for capturing recipient details when a customer accepts the Gift Basket offer from Next Best Action. Creates a Gift Basket Request record and sends a request email to the shipping department.</description>
    <interviewLabel>Gift Basket Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Basket Screen Flow</label>
    <processType>Flow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <status>Active</status>

    <!-- ============================================================ -->
    <!-- ACTION CALLS (grouped)                                        -->
    <!-- ============================================================ -->
    <actionCalls>
        <name>SendShippingEmail</name>
        <label>Send Shipping Department Email</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>ConfirmationScreen</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>shipping@keneland.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubjectTemplate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBodyTemplate</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <!-- ============================================================ -->
    <!-- RECORD CREATES (grouped)                                      -->
    <!-- ============================================================ -->
    <recordCreates>
        <name>CreateGiftBasketRequest</name>
        <label>Create Gift Basket Request</label>
        <locationX>176</locationX>
        <locationY>380</locationY>
        <assignRecordIdToReference>newRequestId</assignRecordIdToReference>
        <connector>
            <targetReference>SendShippingEmail</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recipient_Name__c</field>
            <value>
                <elementReference>recipientNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Street_Address__c</field>
            <value>
                <elementReference>streetAddressInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City__c</field>
            <value>
                <elementReference>cityInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State_Province__c</field>
            <value>
                <elementReference>stateProvinceInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Postal_Code__c</field>
            <value>
                <elementReference>postalCodeInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>countryInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submission_Date_Time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Gift_Basket_Request__c</object>
    </recordCreates>

    <!-- ============================================================ -->
    <!-- RECORD LOOKUPS (grouped)                                      -->
    <!-- ============================================================ -->
    <recordLookups>
        <name>LookupAccount</name>
        <label>Lookup Account</label>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>RecipientInfoScreen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>accountName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>

    <!-- ============================================================ -->
    <!-- SCREENS (ALL grouped together — required by Flow schema)      -->
    <!-- ============================================================ -->
    <screens>
        <name>RecipientInfoScreen</name>
        <label>Recipient Information</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>CreateGiftBasketRequest</targetReference>
        </connector>
        <fields>
            <name>formHeader</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;b&gt;Gift Basket Request for {!accountName}&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Please enter the recipient&apos;s shipping details below. All address fields are required.&lt;/p&gt;</fieldText>
        </fields>
        <fields>
            <name>recipientNameInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>streetAddressInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>cityInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>stateProvinceInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>postalCodeInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>countryInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
    </screens>

    <screens>
        <name>ConfirmationScreen</name>
        <label>Request Submitted</label>
        <locationX>176</locationX>
        <locationY>620</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>confirmationMessage</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;b&gt;Gift Basket Request Submitted Successfully!&lt;/b&gt;&lt;/p&gt;&lt;p&gt;A request has been sent to the shipping department for &lt;b&gt;{!recipientNameInput}&lt;/b&gt;. You will be notified when the gift basket has been dispatched.&lt;/p&gt;</fieldText>
        </fields>
    </screens>

    <!-- ============================================================ -->
    <!-- START                                                         -->
    <!-- ============================================================ -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LookupAccount</targetReference>
        </connector>
    </start>

    <!-- ============================================================ -->
    <!-- TEXT TEMPLATES (grouped)                                      -->
    <!-- ============================================================ -->
    <textTemplates>
        <name>EmailBodyTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>A new Gift Basket Request has been submitted.

Account: {!accountName}
Recipient Name: {!recipientNameInput}
Street Address: {!streetAddressInput}
City: {!cityInput}
State/Province: {!stateProvinceInput}
Postal Code: {!postalCodeInput}
Country: {!countryInput}

Submitted By: {!$User.FirstName} {!$User.LastName}
Submission Date/Time: {!$Flow.CurrentDateTime}

Please arrange fulfillment at your earliest convenience.</text>
    </textTemplates>

    <textTemplates>
        <name>EmailSubjectTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Gift Basket Request - {!accountName} - {!recipientNameInput}</text>
    </textTemplates>

    <!-- ============================================================ -->
    <!-- VARIABLES (grouped)                                           -->
    <!-- ============================================================ -->
    <variables>
        <name>accountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>newRequestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
