<?xml version="1.0" encoding="UTF-8"?>
<!-- Project: Gift Basket | LLD-GiftBasket -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Screen flow for recipient data capture upon gift basket offer acceptance.</description>
    <label>Recipient Information Flow</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>Recipient Information Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recipient_Information</targetReference>
        </connector>
    </start>
    <variables>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>CreatedRequestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <screens>
        <name>Recipient_Information</name>
        <label>Recipient Information</label>
        <locationX>176</locationX>
        <locationY>116</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>Create_Gift_Basket_Request</targetReference>
        </connector>
        <fields>
            <name>RecipientName</name>
            <dataType>String</dataType>
            <fieldText>Recipient Full Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>StreetAddress</name>
            <dataType>String</dataType>
            <fieldText>Street Address</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>City</name>
            <dataType>String</dataType>
            <fieldText>City</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>StateProvince</name>
            <dataType>String</dataType>
            <fieldText>State/Province</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>PostalCode</name>
            <dataType>String</dataType>
            <fieldText>Postal Code</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Country</name>
            <dataType>String</dataType>
            <fieldText>Country</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
    </screens>
    <recordCreates>
        <name>Create_Gift_Basket_Request</name>
        <label>Create Gift Basket Request</label>
        <locationX>176</locationX>
        <locationY>308</locationY>
        <assignRecordIdToReference>CreatedRequestId</assignRecordIdToReference>
        <connector>
            <targetReference>Send_Shipping_Email</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City__c</field>
            <value>
                <elementReference>City</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>Country</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Postal_Code__c</field>
            <value>
                <elementReference>PostalCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recipient_Name__c</field>
            <value>
                <elementReference>RecipientName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State_Province__c</field>
            <value>
                <elementReference>StateProvince</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Street_Address__c</field>
            <value>
                <elementReference>StreetAddress</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submission_Date_Time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Gift_Basket_Request__c</object>
    </recordCreates>
    <actionCalls>
        <name>Send_Shipping_Email</name>
        <label>Send Shipping Email</label>
        <locationX>176</locationX>
        <locationY>428</locationY>
        <actionName>Gift_Basket_Service</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>requestId</name>
            <value>
                <elementReference>CreatedRequestId</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
</Flow>
