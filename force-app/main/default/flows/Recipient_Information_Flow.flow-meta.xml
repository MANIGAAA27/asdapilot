<?xml version="1.0" encoding="UTF-8"?>
<!-- MODIFIED 2026-06-08 — Project: Gift Basket | CodeImplementation-GiftBasket | ASDA -->
<!-- Project: Gift Basket | LLD-GiftBasket -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Guided screen flow for capturing recipient name and shipping address upon acceptance of the Gift Basket offer. Creates a Gift Basket Request record linked to the Account and notifies the shipping department.</description>
    <interviewLabel>Recipient Information Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Recipient Information Flow</label>
    <processType>Flow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <status>Active</status>

    <!-- ============================================================ -->
    <!-- ACTION CALLS (grouped)                                        -->
    <!-- ============================================================ -->
    <actionCalls>
        <name>NotifyShipping</name>
        <label>Notify Shipping Department</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>SuccessScreen</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>shipping@keneland.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubjectText</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBodyText</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <!-- ============================================================ -->
    <!-- RECORD CREATES (grouped)                                      -->
    <!-- ============================================================ -->
    <recordCreates>
        <name>SaveRequestRecord</name>
        <label>Save Gift Basket Request</label>
        <locationX>176</locationX>
        <locationY>380</locationY>
        <assignRecordIdToReference>createdRequestId</assignRecordIdToReference>
        <connector>
            <targetReference>NotifyShipping</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recipient_Name__c</field>
            <value>
                <elementReference>recipientFullName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Street_Address__c</field>
            <value>
                <elementReference>streetAddr</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City__c</field>
            <value>
                <elementReference>cityField</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State_Province__c</field>
            <value>
                <elementReference>stateField</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Postal_Code__c</field>
            <value>
                <elementReference>postalField</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>countryField</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submission_Date_Time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Gift_Basket_Request__c</object>
    </recordCreates>

    <!-- ============================================================ -->
    <!-- RECORD LOOKUPS (grouped)                                      -->
    <!-- ============================================================ -->
    <recordLookups>
        <name>GetAccountDetails</name>
        <label>Get Account Details</label>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>RecipientDetailsScreen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>accountName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>

    <!-- ============================================================ -->
    <!-- SCREENS (ALL grouped together — required by Flow schema)      -->
    <!-- ============================================================ -->
    <screens>
        <name>RecipientDetailsScreen</name>
        <label>Recipient Details</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>SaveRequestRecord</targetReference>
        </connector>
        <fields>
            <name>pageTitle</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;b&gt;Gift Basket Recipient Details&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Complete the form below for &lt;b&gt;{!accountName}&lt;/b&gt;. All fields are required.&lt;/p&gt;</fieldText>
        </fields>
        <fields>
            <name>recipientFullName</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>streetAddr</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>cityField</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>stateField</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>postalField</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>countryField</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
    </screens>

    <screens>
        <name>SuccessScreen</name>
        <label>Request Submitted</label>
        <locationX>176</locationX>
        <locationY>620</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>successMessage</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;b&gt;Success!&lt;/b&gt; Your gift basket request for &lt;b&gt;{!recipientFullName}&lt;/b&gt; has been submitted. The shipping department has been notified.&lt;/p&gt;</fieldText>
        </fields>
    </screens>

    <!-- ============================================================ -->
    <!-- START                                                         -->
    <!-- ============================================================ -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetAccountDetails</targetReference>
        </connector>
    </start>

    <!-- ============================================================ -->
    <!-- TEXT TEMPLATES (grouped)                                      -->
    <!-- ============================================================ -->
    <textTemplates>
        <name>EmailBodyText</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Please process the following gift basket shipping request:

Account: {!accountName}
Recipient: {!recipientFullName}
Address:
  {!streetAddr}
  {!cityField}, {!stateField} {!postalField}
  {!countryField}

Submitted by: {!$User.FirstName} {!$User.LastName}
Date: {!$Flow.CurrentDateTime}

Thank you.</text>
    </textTemplates>

    <textTemplates>
        <name>EmailSubjectText</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Gift Basket Shipping Request - {!accountName} - {!recipientFullName}</text>
    </textTemplates>

    <!-- ============================================================ -->
    <!-- VARIABLES (grouped)                                           -->
    <!-- ============================================================ -->
    <variables>
        <name>accountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>createdRequestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
