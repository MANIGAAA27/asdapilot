<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case Resolution Time Calculation</label>
    <description>Record-triggered after-save flow on Case. Fires only when IsClosed transitions from false to true. Calculates total resolution time in minutes (ClosedDate minus CreatedDate) and stamps it on Resolution_Time_Minutes__c for AHT reporting.</description>
    <interviewLabel>Case Resolution Time Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <runInMode>SystemModeWithSharing</runInMode>

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!-- Formula: calculate resolution time in whole minutes              -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <formulas>
        <name>resolutionMinutes</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>({!$Record.ClosedDate} - {!$Record.CreatedDate}) * 1440</expression>
    </formulas>

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!-- START: RecordTriggered after-save, fires only when Case closes   -->
    <!-- doesRequireRecordChangedToMeetCriteria prevents recursion        -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <connector>
            <targetReference>StampResolutionTime</targetReference>
        </connector>
    </start>

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!-- RECORD UPDATE: stamp Resolution_Time_Minutes__c on the Case      -->
    <!-- inputReference = $Record updates the triggering record by Id     -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <recordUpdates>
        <name>StampResolutionTime</name>
        <label>Stamp Resolution Time</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <inputAssignments>
            <field>Resolution_Time_Minutes__c</field>
            <value>
                <elementReference>resolutionMinutes</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
</Flow>
