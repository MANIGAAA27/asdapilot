<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case Resolution Time Calculation</label>
    <description>Record-triggered flow that calculates and stamps Case.Resolution_Time_Minutes__c when a Case is closed. Computes minutes between CreatedDate and ClosedDate for Average Handle Time reporting.</description>
    <interviewLabel>Case Resolution Time Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <runInMode>SystemModeWithSharing</runInMode>

    <!-- Formula: DateTime subtraction yields days (decimal); * 1440 = minutes -->
    <formulas>
        <name>formulaResolutionMinutes</name>
        <dataType>Number</dataType>
        <scale>2</scale>
        <expression>({!$Record.ClosedDate} - {!$Record.CreatedDate}) * 1440</expression>
    </formulas>

    <!-- START: after-save on Case update, entry criteria: just closed and not yet stamped -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Resolution_Time</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Resolution_Time_Minutes__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- RECORD UPDATE: stamp Resolution_Time_Minutes__c on the triggering Case -->
    <recordUpdates>
        <name>Stamp_Resolution_Time</name>
        <label>Stamp Resolution Time</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Resolution_Time_Minutes__c</field>
            <value>
                <elementReference>formulaResolutionMinutes</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
</Flow>
