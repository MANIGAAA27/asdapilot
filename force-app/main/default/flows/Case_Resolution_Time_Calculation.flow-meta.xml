<!--
    Case_Resolution_Time_Calculation
    Record-triggered Flow on Case (After Save, Update/Create).
    Entry condition: IsClosed = true (current) AND IsClosed = false (prior).
    When the condition is met the flow computes Resolution_Time_Minutes__c
    as the elapsed minutes between Case.CreatedDate and Case.ClosedDate
    and stamps the value via a RecordUpdate on the triggering Case.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case Resolution Time Calculation</label>
    <description>Record-triggered flow that calculates and stamps Resolution_Time_Minutes__c when a Case is closed. Fires once per closure transition (IsClosed false → true).</description>
    <interviewLabel>Case Resolution Time Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <runInMode>SystemModeWithSharing</runInMode>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckWasJustClosed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <decisions>
        <name>CheckWasJustClosed</name>
        <label>Was Case Just Closed?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>DoNothing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Closed Before</defaultConnectorLabel>
        <rules>
            <name>JustClosed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DoNothing</targetReference>
            </connector>
            <label>Yes, Just Closed</label>
        </rules>
    </decisions>

    <variables>
        <name>flowEndMarker</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
