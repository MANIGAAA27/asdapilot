<?xml version="1.0" encoding="UTF-8"?>
<!-- Project: Agent Console Workspace | LLD-AgentConsoleWorkspace -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case Resolution Time Calculation</label>
    <description>Record-triggered flow on Case. When a Case update closes the record and Resolution_Time_Minutes__c is blank, calculates and stamps the resolution time in minutes from CreatedDate to ClosedDate.</description>
    <interviewLabel>Case Resolution Time Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <object>Case</object>
        <triggerType>RecordAfterSave</triggerType>
        <recordTriggerType>Update</recordTriggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Resolution_Time_Minutes__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <connector>
            <targetReference>UpdateResolutionTime</targetReference>
        </connector>
    </start>

    <!-- Formula: (ClosedDate - CreatedDate) * 1440 = resolution minutes -->
    <formulas>
        <name>formulaResolutionMinutes</name>
        <dataType>Number</dataType>
        <expression>({!$Record.ClosedDate} - {!$Record.CreatedDate}) * 1440</expression>
        <scale>0</scale>
    </formulas>

    <recordUpdates>
        <name>UpdateResolutionTime</name>
        <label>Stamp Resolution Time Minutes</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Resolution_Time_Minutes__c</field>
            <value>
                <elementReference>formulaResolutionMinutes</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
</Flow>
