<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case Resolution Time Calculation</label>
    <description>Record-triggered Before Save flow on Case. When Case Status becomes Closed and Resolution_Time_Minutes__c has not yet been stamped, calculates the elapsed time in minutes from CreatedDate to ClosedDate and writes it directly to the record.</description>
    <interviewLabel>Case Resolution Time Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ============================================================ -->
    <!-- START — only enters when Status = Closed AND time not yet    -->
    <!-- stamped (IsNull guard prevents overwriting on re-saves).     -->
    <!-- ============================================================ -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>StampResolutionTime</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Resolution_Time_Minutes__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <!-- ============================================================ -->
    <!-- FORMULA — elapsed minutes between CreatedDate and ClosedDate -->
    <!-- Datetime subtraction yields fractional days; × 24 × 60 =    -->
    <!-- minutes.                                                      -->
    <!-- ============================================================ -->
    <formulas>
        <name>ResolutionTimeMinutes</name>
        <dataType>Number</dataType>
        <expression>({!$Record.ClosedDate} - {!$Record.CreatedDate}) * 24 * 60</expression>
        <scale>0</scale>
    </formulas>

    <!-- ============================================================ -->
    <!-- ASSIGNMENT — writes formula result to $Record before save.   -->
    <!-- No RecordUpdate element needed in Before Save flows.         -->
    <!-- ============================================================ -->
    <assignments>
        <name>StampResolutionTime</name>
        <label>Stamp Resolution Time</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>$Record.Resolution_Time_Minutes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ResolutionTimeMinutes</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
