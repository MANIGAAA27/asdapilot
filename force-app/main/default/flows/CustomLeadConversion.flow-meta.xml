    <!-- Screen 3: Opportunity Options -->
    <screens>
        <name>OpportunityConversionScreen</name>
        <label>Convert Lead: Opportunity</label>
        <locationX>176</locationX>
        <locationY>1440</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>AccountSelectionDecision</targetReference>
        </connector>
        <fields>
            <name>oppHeader</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;h2 style="font-size:1.25rem;font-weight:600;"&gt;Opportunity&lt;/h2&gt;&lt;p&gt;Optionally create an Opportunity from this Lead. The close date defaults to the end of the current quarter.&lt;/p&gt;</fieldText>
        </fields>
        <fields>
            <name>oppChoiceRadio</name>
            <fieldType>RadioButtons</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
            <choiceReferences>choiceCreateOpportunity</choiceReferences>
            <choiceReferences>choiceSkipOpportunity</choiceReferences>
            <defaultValue>
                <stringValue>CREATE</stringValue>
            </defaultValue>
        </fields>
        <fields>
            <name>oppNameField</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
            <defaultValue>
                <elementReference>leadRecord.Company</elementReference>
            </defaultValue>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>oppChoiceRadio</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>CREATE</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>oppAmountField</name>
            <fieldType>InputField</fieldType>
            <dataType>Currency</dataType>
            <isRequired>false</isRequired>
            <defaultValue>
                <elementReference>leadRecord.AnnualRevenue</elementReference>
            </defaultValue>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>oppChoiceRadio</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>CREATE</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>oppCloseDateField</name>
            <fieldType>InputField</fieldType>
            <dataType>Date</dataType>
            <isRequired>true</isRequired>
            <defaultValue>
                <elementReference>endOfQuarterDate</elementReference>
            </defaultValue>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>oppChoiceRadio</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>CREATE</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
    </screens>

