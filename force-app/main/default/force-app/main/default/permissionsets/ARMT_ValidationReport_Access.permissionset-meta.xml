<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>ARMT Validation Report Access</label>
    <description>Grants access to ARMT_ValidationReport__c object and fields, and to the ARMT_PreMigrationValidator and ARMT_ValidationReportController Apex classes.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ARMT_ValidationReport__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ARMT_ValidationReport__c.Report_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ARMT_ValidationReport__c.Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ARMT_ValidationReport__c.Validation_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>ARMT_PreMigrationValidator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ARMT_ValidationReportController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
