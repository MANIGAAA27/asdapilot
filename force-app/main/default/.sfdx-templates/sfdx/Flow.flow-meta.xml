<?xml version="1.0" encoding="UTF-8"?>
<!--
    CANONICAL Screen Flow template — covers the patterns the LLD specifies most
    often: multi-screen wizard, choice/decision branching, SObject lookup,
    SObject create, an Apex action call, and Flow-scoped variables.

    Read salesforceInstructions.ts "Screen Flow & Auto-Launched Flow Rules" for
    the prose contract. The structure below is intentionally exhaustive so you
    can copy + delete the sections you don't need rather than constructing
    pieces from memory.

    CRITICAL RULES THIS FILE DEMONSTRATES:
      • NO <apiVersion> tag (Rule 7).
      • <screens> (plural) at root, never bare <screen> or <FlowScreen>.
      • Every node has integer <locationX> + <locationY>.
      • <start> has <connector><targetReference>...</targetReference></connector>.
      • <decisions> has <defaultConnector> + at least one <rules> entry.
      • Every <rules> has <conditionLogic> AND <connector>.
      • <choiceReferences> in a <screens><fields> resolve to <choices> at root.
      • <actionCalls actionType="apex"> references an @InvocableMethod class
        that exists in the same deploy package.
      • <recordCreates> uses <inputAssignments> (NOT <inputReference>).
      • Cross-references via <targetReference>/<elementReference> match a
        <name> somewhere else in this file.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Opportunity Intake Wizard</label>
    <description>Three-screen wizard: collect opportunity details, ask if user wants to invoke Apex enrichment, branch on the choice, create the opportunity, and confirm.</description>
    <interviewLabel>Opportunity Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <processType>Flow</processType>
    <status>Active</status>
    <runInMode>SystemModeWithSharing</runInMode>

    <!-- ============================================================ -->
    <!-- 1. START node — required for every Flow.                      -->
    <!-- ============================================================ -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CollectDetailsScreen</targetReference>
        </connector>
    </start>

    <!-- ============================================================ -->
    <!-- 2. VARIABLES (declared at Flow root, referenced anywhere).    -->
    <!-- ============================================================ -->
    <variables>
        <name>opportunityName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>createdOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <!-- ============================================================ -->
    <!-- 3. CHOICES (declared at Flow root, referenced by screens).    -->
    <!-- ============================================================ -->
    <choices>
        <name>choiceYes</name>
        <choiceText>Yes, enrich data</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>YES</stringValue>
        </value>
    </choices>
    <choices>
        <name>choiceNo</name>
        <choiceText>No, save as-is</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>NO</stringValue>
        </value>
    </choices>

    <!-- ============================================================ -->
    <!-- 4. SCREENS (plural). Each has connector → next node.          -->
    <!-- ============================================================ -->
    <screens>
        <name>CollectDetailsScreen</name>
        <label>Opportunity Details</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>EnrichDecisionScreen</targetReference>
        </connector>
        <fields>
            <name>welcomeText</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;Enter a name for the new opportunity.&lt;/p&gt;</fieldText>
        </fields>
        <fields>
            <name>opportunityNameInput</name>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
    </screens>

    <screens>
        <name>EnrichDecisionScreen</name>
        <label>Enrich?</label>
        <locationX>176</locationX>
        <locationY>268</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector>
            <targetReference>EvaluateChoice</targetReference>
        </connector>
        <fields>
            <name>enrichChoice</name>
            <fieldType>RadioButtons</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
            <choiceReferences>choiceYes</choiceReferences>
            <choiceReferences>choiceNo</choiceReferences>
        </fields>
    </screens>

    <screens>
        <name>ConfirmationScreen</name>
        <label>Done</label>
        <locationX>312</locationX>
        <locationY>536</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <!-- Terminal screen: no <connector>. -->
        <fields>
            <name>confirmText</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;Opportunity created. Id: {!createdOpportunityId}&lt;/p&gt;</fieldText>
        </fields>
    </screens>

    <!-- ============================================================ -->
    <!-- 5. DECISIONS (branch on choice).                              -->
    <!-- ============================================================ -->
    <decisions>
        <name>EvaluateChoice</name>
        <label>Did user pick Yes?</label>
        <locationX>312</locationX>
        <locationY>268</locationY>
        <defaultConnector>
            <targetReference>CreateOpportunityWithoutEnrich</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Otherwise</defaultConnectorLabel>
        <rules>
            <name>YesEnrich</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>enrichChoice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>YES</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EnrichViaApex</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>

    <!-- ============================================================ -->
    <!-- 6. ACTION CALL (invoke @InvocableMethod Apex).                -->
    <!-- ============================================================ -->
    <actionCalls>
        <name>EnrichViaApex</name>
        <label>Enrich Opportunity Data</label>
        <locationX>440</locationX>
        <locationY>402</locationY>
        <actionName>OpportunityEnrichmentService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>CreateOpportunityWithEnrich</targetReference>
        </connector>
        <inputParameters>
            <name>opportunityNameInput</name>
            <value>
                <elementReference>opportunityNameInput</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <!-- ============================================================ -->
    <!-- 7. RECORD CREATES (Yes branch and No branch).                 -->
    <!-- ============================================================ -->
    <recordCreates>
        <name>CreateOpportunityWithEnrich</name>
        <label>Create Opportunity (Enriched)</label>
        <locationX>440</locationX>
        <locationY>536</locationY>
        <assignRecordIdToReference>createdOpportunityId</assignRecordIdToReference>
        <connector>
            <targetReference>ConfirmationScreen</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>opportunityNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Prospecting</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordCreates>

    <recordCreates>
        <name>CreateOpportunityWithoutEnrich</name>
        <label>Create Opportunity</label>
        <locationX>184</locationX>
        <locationY>402</locationY>
        <assignRecordIdToReference>createdOpportunityId</assignRecordIdToReference>
        <connector>
            <targetReference>ConfirmationScreen</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>opportunityNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Prospecting</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordCreates>
</Flow>
