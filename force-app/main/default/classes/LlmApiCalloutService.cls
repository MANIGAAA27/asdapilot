/**
  @file              LlmApiCalloutService.cls
  @description       Provides services to perform API callouts to a Large Language Model (LLM) for summary generation. Handles authentication and error management for API interactions.
  @dependencies      (none)
  @calledBy          SummarizationQueueable
  @testClass         LlmApiCalloutServiceTest
 */
public with sharing class LlmApiCalloutService {
    /**
      Summarizes Case data using an LLM.
      @param payload A JSON-formatted string containing case data.
      @return The summary text generated by the LLM.
      @throws LlmApiException If the API call fails.
      @calledBy SummarizationQueueable.execute
      @testMethods test_summarizeCase_success
     */
    public static String summarizeCase(String payload) throws LlmApiException {
        HttpRequest req = new HttpRequest();
        req.setEndpoint('callout:LlmEndpoint/api/summarize');
        req.setMethod('POST');
        req.setHeader('Content-Type', 'application/json');
        req.setBody(payload);

        Http http = new Http();
        HttpResponse res = http.send(req);

        if (res.getStatusCode() == 200) {
            return res.getBody();
        } else {
            throw new LlmApiException('Failed to summarize case: ' + res.getStatus());
        }
    }
}